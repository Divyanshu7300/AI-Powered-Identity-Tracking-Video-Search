BACKEND_PORT=8000
FRONTEND_PORT=3000

# Comma-separated browser origins allowed to call the backend directly.
# In production, set this to your frontend URL, for example:
# CORS_ORIGIN=https://your-frontend.example.com
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
MOT_REID_AUTH_USERNAME=admin
# Use a long random value in every deployed environment.
MOT_REID_AUTH_PASSWORD=replace-with-a-long-random-password
MOT_REID_AUTH_SECRET=replace-with-a-long-random-secret
# Secret shared between Next.js server proxy and FastAPI backend for trusted proxy header verification
MOT_REID_INTERNAL_PROXY_SECRET=replace-with-a-long-random-proxy-secret
# Set false when accounts should only be provisioned by an administrator.
MOT_REID_ALLOW_SIGNUP=false
# Optional location for registered account records.
MOT_REID_AUTH_DB=data/auth/users.sqlite3
COOKIE_SECURE=false
MOT_REID_CACHE_DIR=/tmp/mot-reid-cache
# Maximum accepted uploaded video size in bytes (512 MiB).
MOT_REID_MAX_UPLOAD_BYTES=536870912
MOT_REID_MAX_IMAGE_BYTES=10485760
MOT_REID_UPLOADS_PER_HOUR=10
MOT_REID_SESSION_QUOTA_BYTES=2147483648
MOT_REID_LOGIN_ATTEMPTS_PER_MINUTE=5

# Used by the frontend server-side proxy.
# Local frontend dev: http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Multimodal VLM Captioning Configuration
# Fast default for reliable video processing. Set to florence, blip, or auto
# only when the captioning model is already available and the extra runtime is acceptable.
# Keep this as heuristic for fast processing. Use auto only when richer captions
# are worth the additional Florence/BLIP model download and inference time.
CAPTION_MODEL=heuristic
FLORENCE_MODEL_NAME=microsoft/Florence-2-base
BLIP_MODEL_NAME=Salesforce/blip-image-captioning-base

# Leave off during normal uploads to avoid an on-demand model download. Enable
# after SigLIP is installed locally if vector-based semantic search is needed.
SEMANTIC_ENABLE_CLIP=false
# Best default for text-to-person retrieval. A separate vector collection is
# created per model, so re-index after changing this value.
SEMANTIC_MODEL_NAME=google/siglip-base-patch16-224

# Stronger out-of-the-box body Re-ID model. For production, replace this with
# a camera-domain fine-tuned checkpoint through REID_WEIGHTS.
REID_MODEL_NAME=osnet_ain_x1_0
REID_WEIGHTS=
