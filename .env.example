BACKEND_PORT=8000
FRONTEND_PORT=3000

# Comma-separated browser origins allowed to call the backend directly.
# In production, set this to your frontend URL, for example:
# CORS_ORIGIN=https://your-frontend.example.com
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
MOT_REID_CACHE_DIR=/tmp/mot-reid-cache

# Used by the frontend server-side proxy.
# Local frontend dev: http://127.0.0.1:8000
# Docker Compose: http://backend:8000
API_BASE_URL=http://127.0.0.1:8000

# Optional browser WebSocket base URL if you expose backend websockets directly.
# Example: wss://your-api.example.com
NEXT_PUBLIC_WS_BASE=

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=
